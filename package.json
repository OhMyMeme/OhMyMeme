  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
