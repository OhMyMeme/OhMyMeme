{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "vitest/jsdom"]
  },
  "include": [
    "src/ohmymeme/presentation/frontend/main/features/memes/**/*.vue",
    "src/ohmymeme/presentation/frontend/main/shared/**/*.ts",
    "src/ohmymeme/presentation/frontend/settings-vue/**/*.ts",
    "src/ohmymeme/presentation/frontend/settings-vue/**/*.vue",
    "tests/frontend/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // pywebview's runtime-injected API has no static declaration yet.
    "src/ohmymeme/presentation/frontend/main/shared/bridge.ts",
    // pywebview evaluates these globals directly in the host WebView.
    "src/ohmymeme/presentation/frontend/main/app/main.ts",
    // 该测试经 vitest 运行；其 import 图属 main/app 范围，尚未纳入类型检查。
    // 待将 main/app 整体纳入类型检查时移除该排除并修复依赖图类型问题。
    "tests/frontend/main_window_virtual.test.ts"
  ]
}
